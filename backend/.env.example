# ---- DrillGuard backend configuration -------------------------------------
# Copy to .env and fill in. On shared hosting, set these in your host panel.

APP_ENV=local
APP_DEBUG=true
# Comma-separated origins allowed to call this API (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# ---- Database (MySQL / MariaDB on cPanel) ---------------------------------
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=drillguard
DB_USER=root
DB_PASS=
# For local tests without a DB server, set DB_DRIVER=sqlite and DB_PATH below.
DB_PATH=

# ---- Auth -----------------------------------------------------------------
# Long random string. Rotating it logs everyone out. NEVER commit the real one.
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=12

# ---- Replay data ----------------------------------------------------------
# Directory holding catalog.json + <id>.json exported from the ML pipeline.
REPLAY_DIR=data/replay

# ---- Inference proxy ------------------------------------------------------
# The PHP API proxies /api/infer/* to the loopback Python model service, so
# the model server is never exposed to the internet (cPanel VPS pattern).
INFER_URL=http://127.0.0.1:8099

# ---- Email alerts (PHPMailer / SMTP) --------------------------------------
# Leave MAIL_ENABLED=false to run in dry-run (logged, not sent) mode.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=alerts@drillguard.local
MAIL_FROM_NAME="DrillGuard Alerts"

# ---- SMS alerts (pluggable gateway) ---------------------------------------
# Provider: "log" (dry-run), "termii", or "twilio". Leave as log until you have keys.
# OFFLINE STORE-AND-FORWARD: if the internet link is down when an alert fires,
# the SMS is QUEUED (status "queued" in the notifications table, body kept) and
# re-sent automatically on the next alert or via POST /api/notifications/retry.
SMS_PROVIDER=log
# Optional gateway URL override (testing / self-hosted gateway). Default: Termii.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=DrillGuard
# Twilio only:
SMS_ACCOUNT_SID=
SMS_FROM=
