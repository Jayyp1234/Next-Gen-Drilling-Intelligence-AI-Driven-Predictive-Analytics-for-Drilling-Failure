{
    "name": "drillguard/backend",
    "description": "DrillGuard PHP backend — auth, incidents, alerts, replay serving, email/SMS notifications",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "DrillGuard\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
