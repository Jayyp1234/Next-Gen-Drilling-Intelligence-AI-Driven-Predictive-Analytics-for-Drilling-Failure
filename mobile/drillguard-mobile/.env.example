# Point the mobile app at the DrillGuard PHP backend.
#
# iOS Simulator: default (http://localhost:8077) works — it shares the Mac's localhost.
# Physical phone (Expo Go): set this to your Mac's LAN IP so the phone can reach the API,
#   e.g. EXPO_PUBLIC_API_BASE=http://192.168.1.20:8077   (find it with `ipconfig getifaddr en0`)
EXPO_PUBLIC_API_BASE=http://localhost:8077
EXPO_PUBLIC_INFER_BASE=http://localhost:8099
